# User Access Tokens
HUGGING_FACE_API_TOKEN=hf_xxx

# HUGGING_FACE API CONFIGS
EMBEDDING_PIPELINE_TAG=feature-extraction
EMBEDDING_LIBRARY=sentence-transformers

# CACHE TTLs (seconds)
API_CLIENT_TTL=3600

# POSTGRESQL
# Must use the asyncpg driver; scripts/init_db.sql creates this role and database.
DATABASE_URL=postgresql+asyncpg://tuner:CHANGEME@127.0.0.1:5432/tuner
DB_ECHO=false

# UPLOADS
UPLOAD_DIR=uploads
MODEL_DIR=models
MODEL_SEARCH_LIMIT=10

# CHAT
# Retrieval runs locally against the stored vectors; the answer is written by
# a served model on the Hugging Face Inference API, using the token above.
# CHAT_PROVIDER picks the inference partner — "auto" takes whichever serves it.
CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
CHAT_PROVIDER=auto
CHAT_MAX_TOKENS=1024
CHAT_TEMPERATURE=0.2
# Passages put in front of the model per question; the UI can override it.
CHAT_CONTEXT_CHUNKS=6
